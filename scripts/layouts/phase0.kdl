// Phase 0: triad-proto + triad-core in parallel (no dependencies)
// Launch: zellij --session triad-phase0 --layout scripts/layouts/phase0.kdl
layout {
    tab name="phase0-proto" {
        pane name="triad-proto" command="bash" {
            args "-c" "/home/jreuben1/Code/triad/scripts/agents/run-triad-proto.sh"
        }
    }
    tab name="phase0-core" {
        pane name="triad-core" command="bash" {
            args "-c" "/home/jreuben1/Code/triad/scripts/agents/run-triad-core.sh"
        }
    }
    tab name="status" {
        pane name="status" command="bash" {
            args "-c" "watch -n 30 /home/jreuben1/Code/triad/scripts/status.sh"
        }
    }
}
