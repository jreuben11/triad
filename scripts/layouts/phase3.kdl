// Phase 3+: engine (ralph), SDK + CLI in parallel
// Depends on Phase 2 merged
// Launch: zellij --session triad-phase3 --layout scripts/layouts/phase3.kdl
layout {
    tab name="engine (ralph)" {
        pane name="runner-engine" command="bash" {
            args "-c" "/home/jreuben1/Code/triad/scripts/agents/run-runner-engine.sh"
        }
    }
    tab name="triad-sdk" {
        pane name="triad-sdk" command="bash" {
            args "-c" "/home/jreuben1/Code/triad/scripts/agents/run-triad-sdk.sh"
        }
    }
    tab name="triad-cli" {
        pane name="triad-cli" command="bash" {
            args "-c" "/home/jreuben1/Code/triad/scripts/agents/run-triad-cli.sh"
        }
    }
    tab name="status" {
        pane name="status" command="bash" {
            args "-c" "watch -n 30 /home/jreuben1/Code/triad/scripts/status.sh"
        }
    }
}
