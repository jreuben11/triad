// Phase 2: patterns in parallel (depends on Phase 1 merged)
// CDC/Outbox/etc as parallel agent, Saga/EOS as Ralph loop
// Launch: zellij --session triad-phase2 --layout scripts/layouts/phase2.kdl
layout {
    tab name="patterns-cdc-outbox" {
        pane name="patterns-cdc-outbox" command="bash" {
            args "-c" "/home/jreuben1/Code/triad/scripts/agents/run-patterns-cdc-outbox.sh"
        }
    }
    tab name="patterns-saga-eos (ralph)" {
        pane name="patterns-saga-eos" command="bash" {
            args "-c" "/home/jreuben1/Code/triad/scripts/agents/run-patterns-saga-eos.sh"
        }
    }
    tab name="status" {
        pane name="status" command="bash" {
            args "-c" "watch -n 30 /home/jreuben1/Code/triad/scripts/status.sh"
        }
    }
}
