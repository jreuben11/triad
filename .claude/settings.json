{
  "permissions": {
    "allow": [
      "Bash(cargo clippy *)",
      "Bash(cargo nextest *)",
      "Bash(cargo fmt *)",
      "Bash(cargo llvm-cov *)",
      "Bash(cargo test *)",
      "Bash(cargo build *)",
      "Bash(cargo install *)",
      "Bash(git worktree *)",
      "Bash(git merge --ff-only *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git -C *)",
      "Bash(git branch *)",
      "Bash(zellij action go-to-tab-name *)",
      "Bash(zellij action close-tab)",
      "Bash(ls -1d *)",
      "Bash(CARGO_TARGET_DIR=/tmp/triad-target-*)",
      "Bash(gh pr *)",
      "Bash(cargo check *)",
      "Bash(cargo deny *)",
      "Bash(cargo machete)",
      "Bash(cargo semver-checks)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git rev-parse *)",
      "Bash(git rev-list *)",
      "Bash(git stash *)",
      "Bash(git log *)",
      "Bash(printf *)",
      "Bash(chmod +x *)",
      "Bash(zellij action new-tab *)",
      "Bash(zellij action list-tabs)",
      "Bash(zellij action go-to-tab-by-id *)",
      "Bash(zellij action write-chars *)",
      "Bash(zellij action rename-tab *)",
      "Bash(mkdir *)",
      "Bash(rm *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(export CARGO_TARGET_DIR=*)",
      "Bash(cargo run *)",
      "Bash(cargo add *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(rmdir *)",
      "Bash(touch *)",
      "Edit",
      "Write"
    ],
    "deny": [],
    "ask": []
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit-cargo-check.sh",
            "timeout": 60000,
            "statusMessage": "Running cargo check..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash(git push *)",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/pre-push-gate.sh",
            "timeout": 120000,
            "statusMessage": "Pre-push: fmt + clippy gate..."
          }
        ]
      }
    ]
  }
}
