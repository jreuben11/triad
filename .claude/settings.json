{
  "permissions": {
    "allow": [
      "Bash(cargo clippy *)",
      "Bash(cargo nextest *)",
      "Bash(cargo fmt *)",
      "Bash(cargo llvm-cov *)",
      "Bash(cargo test *)",
      "Bash(cargo build *)",
      "Bash(cargo install *)",
      "Bash(git worktree *)",
      "Bash(git merge --ff-only *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git -C *)",
      "Bash(git branch *)",
      "Bash(zellij action go-to-tab-name *)",
      "Bash(zellij action close-tab)",
      "Bash(ls -1d *)",
      "Bash(CARGO_TARGET_DIR=/tmp/triad-target-*)",
      "Bash(gh pr *)"
    ],
    "deny": [],
    "ask": []
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit-cargo-check.sh",
            "timeout": 60000,
            "statusMessage": "Running cargo check..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash(git push *)",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/pre-push-gate.sh",
            "timeout": 120000,
            "statusMessage": "Pre-push: fmt + clippy gate..."
          }
        ]
      }
    ]
  }
}
